:80 {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /v1/notifications* {
		reverse_proxy notification-service:8082
	}

	handle /v1/me/devices* {
		reverse_proxy notification-service:8082
	}

	handle /v1/* {
		reverse_proxy rental-service:8081
	}

	handle {
		@hasWeb file {
			root /srv/web
			try_files /index.html
		}
		handle @hasWeb {
			root * /srv/web
			try_files {path} {path}.html /index.html
			file_server
		}
		respond "Thuê Đồ Sinh Viên - API /v1 sẵn sàng (Next.js Web chưa build)" 200
	}
}
